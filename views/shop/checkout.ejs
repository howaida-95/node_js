<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/cart.css">
    </head>

    <body>
    <%- include('../includes/navigation.ejs') %>
        <main>
            <ul class="cart__item-list">
                <% products.forEach(p => { %>
                    <li class="cart__item">
                        <p><%= p.productId.title %>(<%= p.quantity%>)</p>
                    </li>
                <% }) %>
            </ul>
            <div class="centered">
                <h2>Total: $<%= totalSum %></h2>
            </div>
            <!-- ordered form start (front-side) -->
            <div class="centered">
                <button id="checkout-button">Pay with Stripe</button>
            </div>
            
            <script src="https://js.stripe.com/v3/"></script>
            <script>
                document.getElementById("checkout-button").addEventListener("click", async () => {
                    const response = await fetch("/create-checkout-session", { method: "POST" });
                    const session = await response.json();
                    
                    const stripe = Stripe("pk_test_51R46YgQoNVe6lkxRO9ns0n7yWjU1o1m6u4OyMcNOCjyEjp8CB7wAURhAGagrpY3z149HzDKkUexmQGf5ksv8oSgn00uIaMGEJA");
                    stripe.redirectToCheckout({ sessionId: session.id });
                });
            </script>
            <!-- ordered form end -->
        </main>
    <%- include('../includes/end.ejs') %>
<!--
action="/create-order" ==> target a route in our server to handle the order
method="POST" ==> send the data to the server
## the script ==> create the input field for the user 
## publishable key ==> the key that stripe uses to identify our account &  collect the payment info
-->